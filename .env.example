# =============================================================================
# Infrastructure .env
# =============================================================================
# Quick start:  cp .env.example .env && ./start.sh
#
# Local dev defaults work out of the box — no edits needed.
# For production (DigitalOcean, AWS, etc.), you MUST change:
#   1. POSTGRES_PASSWORD  (default is "postgres" — trivially exploitable)
#   2. LANGFUSE_SECRET, LANGFUSE_SALT  (defaults are marked dev-only)
#   3. UMAMI_SECRET  (same)
#   4. LANGFUSE_INIT_* vars — REMOVE them in prod; do first-user setup manually
#   5. TRAEFIK_INSECURE=false
# Generate secrets with: openssl rand -hex 32  (hex avoids URL-breaking chars)
# =============================================================================

# --- Profiles ---
# "local" enables Mailpit (email catcher). Remove for production.
COMPOSE_PROFILES=local

# --- Traefik ---
TRAEFIK_INSECURE=true
TRAEFIK_DASHBOARD_BIND=127.0.0.1
# HTTP_BIND / HTTPS_BIND: interface for entrypoints. Default 0.0.0.0 (all).
# Set to 127.0.0.1 to hide from the network (useful when TLS isn't set up yet).
# HTTP_BIND=0.0.0.0
# HTTPS_BIND=0.0.0.0
# Production: set ACME email for Let's Encrypt
# ACME_EMAIL=you@example.com

# --- Cloudflare DNS-01 (production, required for sites behind CF proxy) ---
# Scoped API token: Zone:Read + DNS:Edit on the target zone.
# Create at https://dash.cloudflare.com/profile/api-tokens
# CF_DNS_API_TOKEN=<token>

# Trusted reverse-proxy IPs for ForwardedHeaders (real client IP).
# Production (behind Cloudflare): use https://www.cloudflare.com/ips/ — keep updated.
# TRUSTED_PROXY_IPS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_BIND=127.0.0.1
# Production: rotate password (MUST), leave bind on 127.0.0.1 (containers reach
# postgres over the 'infra' docker network — external clients should tunnel).
# POSTGRES_PASSWORD=<generate with: openssl rand -hex 32>

# --- Redis ---
REDIS_ARGS=--save 60 1
REDIS_HEALTHCHECK_ARGS=
REDIS_BIND=127.0.0.1
# Production: require password, set memory limit
# REDIS_ARGS=--requirepass <password> --maxmemory 512mb --maxmemory-policy noeviction
# REDIS_HEALTHCHECK_ARGS=-a <password>

# --- Phoenix — LLM observability (THE standard; enable via COMPOSE_PROFILES=phoenix) ---
# One container against the shared postgres, ~400 MiB. Runs the same on local,
# zora and aws01 — that sameness is the point. Enable with:
#   COMPOSE_PROFILES=local,phoenix
#
# One-time setup per host, BEFORE the first start:
#   docker exec postgres createdb -U postgres phoenix
#   openssl rand -hex 32   # x2, for the two secrets below
PHOENIX_SECRET=
# Bearer token used by app instrumentation. MUST differ from PHOENIX_SECRET,
# be >=32 chars, and contain a digit and a lowercase letter (hex satisfies all).
# Apps send traces with:  Authorization: Bearer <this>
PHOENIX_ADMIN_SECRET=
# Initial password for the built-in admin@localhost account. Strong-password
# policy is on: 12+ chars with upper, lower, digit and special.
PHOENIX_ADMIN_PASSWORD=Local-Dev-Only-1!
PHOENIX_DOMAIN=phoenix.localhost
PHOENIX_BIND=127.0.0.1
PHOENIX_TRAEFIK=true
# Spans older than this are deleted. 0 = keep forever (upstream default,
# deliberately overridden — nothing else prunes that table).
PHOENIX_RETENTION_DAYS=90
PHOENIX_MEM=1g
# Production: real domain + Let's Encrypt.
# PHOENIX_DOMAIN=phoenix.yourdomain.com
# PHOENIX_CERTRESOLVER is intentionally absent — see the compose comment.
# On a server, leave PHOENIX_TRAEFIK=false and tunnel instead:
#   ssh -L 6006:localhost:6006 <host>

# --- Langfuse v4 (SUPERSEDED by Phoenix; enable via COMPOSE_PROFILES=langfuse) ---
# Kept working and tested, but not the default anywhere. Phoenix covers cost
# tracking and prompt management too, so enable this only if you need MIT
# licensing or hit trace volumes where Phoenix's Postgres-backed span storage
# stops keeping up. Expect ~1.85 GiB across four containers instead of one.
# Off by default. The stack is four containers (langfuse-web, langfuse-worker,
# clickhouse, minio) and ~2.5 GiB of memory caps — only turn it on where the
# host has the headroom. Enable with: COMPOSE_PROFILES=local,langfuse
#
# One-time setup per host, BEFORE the first start:
#   docker exec postgres createdb -U postgres langfuse
#   openssl rand -hex 32   # x3, for the three secrets below
#
# The three *_KEY / *_PASSWORD vars below have NO defaults — compose refuses to
# start without them. That is deliberate: ENCRYPTION_KEY in particular cannot be
# rotated without invalidating every encrypted row, so it must be set once,
# per environment, and then left alone.
LANGFUSE_IMAGE_TAG=4
LANGFUSE_SECRET=local-langfuse-secret-dev-only
LANGFUSE_SALT=local-langfuse-salt-dev-only
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_URL=https://langfuse.localhost
LANGFUSE_DOMAIN=langfuse.localhost
LANGFUSE_BIND=127.0.0.1
LANGFUSE_TRAEFIK=true
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
CLICKHOUSE_BIND=127.0.0.1
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
MINIO_BIND=127.0.0.1
# Local dev ONLY: seeds a default user/org on first start.
# Production: DELETE these five LANGFUSE_INIT_* lines; create the first user
# manually (otherwise a weak default password is baked into the DB).
LANGFUSE_INIT_ORG_ID=local-dev
LANGFUSE_INIT_ORG_NAME=Local Dev
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=local-dev-only-change-me
# Production: generate real secrets, real domain, Let's Encrypt TLS.
# LANGFUSE_SECRET=<generate with: openssl rand -hex 32>
# LANGFUSE_SALT=<generate with: openssl rand -hex 32>
# LANGFUSE_URL=https://langfuse.yourdomain.com
# LANGFUSE_DOMAIN=langfuse.yourdomain.com
# LANGFUSE_CERTRESOLVER=letsencrypt-dns
#
# NOTE: v4's default ingestion mode rejects Python SDK <=v2 and JS/TS SDK <=v3.
# Bump the Langfuse SDK in a project before pointing it at this.

# --- Umami ---
UMAMI_SECRET=local-umami-secret-dev-only
UMAMI_BIND=127.0.0.1
UMAMI_TRAEFIK=true
UMAMI_DOMAIN=analytics.local
# Production: real secret, real domain, Let's Encrypt TLS.
# After first login (admin / umami) — CHANGE THE PASSWORD IMMEDIATELY.
# UMAMI_SECRET=<generate with: openssl rand -hex 32>
# UMAMI_DOMAIN=analytics.yourdomain.com
# UMAMI_TLS=true
# UMAMI_CERTRESOLVER=letsencrypt

# --- Vaultwarden (optional; enable via COMPOSE_PROFILES=vaultwarden) ---
# Production only — gated behind a compose profile so local dev doesn't
# spin it up by accident.
# COMPOSE_PROFILES=vaultwarden              # or "vaultwarden,local" combined
# VAULTWARDEN_TRAEFIK=true
# VAULTWARDEN_HOST=vault.yourdomain.com
# VAULTWARDEN_DOMAIN=https://vault.yourdomain.com
# VAULTWARDEN_CERTRESOLVER=letsencrypt-dns
# VAULTWARDEN_ADMIN_TOKEN=<argon2 hash — bitwarden admin panel; generate with: vaultwarden hash>
# VAULTWARDEN_SIGNUPS=false

# --- Volume names (override to preserve existing data on a server) ---
# POSTGRES_VOLUME=my_postgres_data
# REDIS_VOLUME=my_redis_data
# TRAEFIK_VOLUME=my_traefik_letsencrypt
# VAULTWARDEN_VOLUME=vault_vaultwarden_data  # existing data on a migrated server
# Langfuse volumes default to langfuse_-prefixed names so they never collide
# with an unrelated `clickhouse_data`/`minio_data` on the host. Point these at
# the v3-era volumes only if you actually want to migrate that data in place.
# CLICKHOUSE_VOLUME=clickhouse_data
# CLICKHOUSE_LOGS_VOLUME=clickhouse_logs
# MINIO_VOLUME=minio_data

# --- Neo4j 5 Community ---
# Format: user/password. Dev default is weak — override in prod.
# Password must be >= 8 chars (Neo4j enforces).
NEO4J_AUTH=neo4j/neo4j-local-dev-password

# --- Langfuse memory caps (per-host tuning) ---
# Defaults suit a host with >=8 GiB free. On a tight host, lower these — the
# stack still works: web 1792m/heap 1280, worker 1g, clickhouse 896m, minio 256m
# was verified stable (0 restarts, ingestion OK) and saves ~0.5 GiB.
#
# ClickHouse's cap is effectively a RESERVATION — it fills to ~0.9x whatever you
# give it and stays there. Lowering it is the single biggest lever on this stack.
# LANGFUSE_WEB_MEM=1792m
# LANGFUSE_WEB_HEAP_MB=1280
# LANGFUSE_WORKER_MEM=1g
# LANGFUSE_CLICKHOUSE_MEM=896m
# LANGFUSE_MINIO_MEM=256m
